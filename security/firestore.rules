rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if request is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    // Helper: Check ownership of target user document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // DEFAULT DENY: Reject all unspecified access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // STRICT TENANT ISOLATION BY USER ID
    // Path: /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Journal entries: /users/{userId}/journals/{journalId}
      match /journals/{journalId} {
        // Only the document owner can read or delete
        allow read, delete: if isOwner(userId);
        
        // Creation validation: payload userId must match auth.uid
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.content is string
          && request.resource.data.createdAt != null;
          
        // Update validation: owner cannot alter original userId
        allow update: if isOwner(userId)
          && request.resource.data.userId == resource.data.userId;

        // Multi-turn conversation logs: /users/{userId}/journals/{journalId}/turns/{turnId}
        match /turns/{turnId} {
          allow read, write: if isOwner(userId);
        }
      }
    }
  }
}
